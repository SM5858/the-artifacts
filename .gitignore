.DS_Store

# ---- Unity project (lives in game/) ----
# Generated by the editor; never commit.
/game/[Ll]ibrary/
/game/[Tt]emp/
/game/[Oo]bj/
/game/[Bb]uild/
/game/[Bb]uilds/
/game/[Ll]ogs/
/game/[Uu]ser[Ss]ettings/
/game/[Mm]emoryCaptures/
/game/[Rr]ecordings/

# Asset Store tools and plugin caches
/game/[Aa]ssets/AssetStoreTools*
/game/[Aa]ssets/Plugins/Editor/JetBrains*

# Third-party assets whose license forbids public redistribution
# (most Asset Store packages). Keep them here; this repo is public.
/game/[Aa]ssets/ThirdParty/
/game/[Aa]ssets/ThirdParty.meta

# IDE / solution files regenerated by Unity
/game/.vs/
/game/.vscode/
/game/.idea/
/game/.gradle/
/game/ExportedObj/
/game/.consulo/
/game/*.csproj
/game/*.unityproj
/game/*.sln
/game/*.slnx
/game/*.suo
/game/*.tmp
/game/*.user
/game/*.userprefs
/game/*.pidb
/game/*.booproj
/game/*.svd
/game/*.pdb
/game/*.mdb
/game/*.opendb
/game/*.VC.db
/game/*.pidb.meta
/game/*.pdb.meta
/game/*.mdb.meta

# Crash reports and build artifacts
/game/sysinfo.txt
/game/crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app

# Secrets: API keys for the Guardian model and backend never go in git
.env
.env.*
!.env.example

# .NET build output for tools/CoreTests
/tools/**/bin/
/tools/**/obj/
/server/**/bin/
/server/**/obj/

# Raw AI-generated models (tools/blender/prepare_generated.py keeps them; tens of MB each)
/art_source/
